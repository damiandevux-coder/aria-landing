---
import { PLATFORM_URL } from "../lib/links";
const year = new Date().getFullYear();
---

<footer class="band bg-ink-2" style="--z: 10">
  <div
    class="mx-auto flex max-w-[1200px] flex-col gap-6 px-6 py-10 text-[14px] text-fg-3 md:flex-row md:items-center md:justify-between md:px-10"
  >
    <div class="flex items-center gap-2.5">
      <span class="grid h-6 w-6 place-items-center rounded-[6px] bg-blue text-[13px] font-bold leading-none text-white">A</span>
      <span class="font-semibold text-fg">Aria</span>
      <span>by HyperCLI</span>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
      <a href={PLATFORM_URL} class="transition-colors hover:text-fg" target="_blank" rel="noopener noreferrer">agent.hypercli.com</a>
      <a href="#" class="transition-colors hover:text-fg">Privacy</a>
      <a href="#" class="transition-colors hover:text-fg">Terms</a>
      <a href="#" class="transition-colors hover:text-fg">Status</a>
    </nav>
    <p class="tnum">&copy; {year} HyperCLI</p>
  </div>
</footer>

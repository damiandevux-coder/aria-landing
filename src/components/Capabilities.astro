---
import { BroadcastIcon as Broadcast, MagnifyingGlassIcon as MagnifyingGlass, GlobeIcon as Globe, TerminalIcon as Terminal, FilePdfIcon as FilePdf, CalendarCheckIcon as CalendarCheck, ArrowRightIcon as ArrowRight } from "@phosphor-icons/react";
import Label from "./Label.astro";

const cell =
  "group relative overflow-hidden rounded-card border border-line bg-ink-3/60 p-6 transition-[border-color,background-color] duration-300 hover:border-line-2 hover:bg-ink-3";
---

<section id="toolkit" class="band scroll-mt-16 bg-ink py-24 md:py-32" style="--z: 5">
  <div class="mx-auto max-w-[1200px] px-6 md:px-10">
    <header class="max-w-2xl">
      <Label>Toolkit</Label>
      <a-words class="mt-5">
        <h2 class="text-3xl font-bold sm:text-4xl md:text-5xl">One agent. The whole toolkit.</h2>
      </a-words>
      <p data-reveal data-delay="1" class="mt-4 max-w-[52ch] text-lg text-fg-2">
        Aria runs on OpenClaw, so she has every tool a capable agent needs. There is nothing to configure.
      </p>
    </header>

    <div class="mt-12 grid gap-4 md:grid-cols-4">
      <div data-reveal class:list={[cell, "md:col-span-2"]}>
        <div
          class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-blue/20 blur-3xl transition-opacity duration-500 group-hover:opacity-100 md:opacity-70"
          aria-hidden="true"
        ></div>
        <div class="relative flex h-full flex-col justify-between gap-8">
          <div>
            <Broadcast className="h-6 w-6 text-blue-2" weight="regular" />
            <h3 class="mt-4 text-xl font-semibold">Reads across channels</h3>
            <p class="mt-2 max-w-[40ch] text-[15px] leading-relaxed text-fg-2">
              Context from #sales shows up in the brief you asked for in #growth. She only reads where she is invited.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2 text-[13px]">
            {["#sales", "#support", "#pricing"].map((c) => (
              <span class="rounded-chip border border-line bg-ink-2 px-2.5 py-1 font-medium text-fg-2">{c}</span>
            ))}
            <ArrowRight className="h-4 w-4 text-fg-3" weight="bold" />
            <span class="rounded-chip bg-blue/15 px-2.5 py-1 font-medium text-blue-2">brightwater-brief.pdf</span>
          </div>
        </div>
      </div>

      <div data-reveal data-delay="1" class={cell}>
        <MagnifyingGlass className="h-6 w-6 text-blue-2" weight="regular" />
        <h3 class="mt-4 text-xl font-semibold">Web search</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-fg-2">Searches, opens the sources, and cites them in what she hands back.</p>
      </div>

      <div data-reveal data-delay="2" class={cell}>
        <Globe className="h-6 w-6 text-blue-2" weight="regular" />
        <h3 class="mt-4 text-xl font-semibold">Browser</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-fg-2">
          Fills forms, reads dashboards, and screenshots what she found so you can check it.
        </p>
      </div>

      <div data-reveal data-delay="1" class:list={[cell, "md:col-span-2"]}>
        <div class="grid h-full gap-6 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
          <div>
            <Terminal className="h-6 w-6 text-blue-2" weight="regular" />
            <h3 class="mt-4 text-xl font-semibold">Code execution</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-fg-2">
              Her own machine with Python, Node and a shell. She clones repos, runs the tests, and opens the PR.
            </p>
          </div>
          <pre
            class="tnum self-end overflow-hidden rounded-[10px] border border-line bg-ink-2 p-4 font-mono text-[12.5px] leading-relaxed text-fg-2"><code><span class="text-fg-3">$</span> git clone web-app
<span class="text-fg-3">$</span> pnpm test pricing
<span class="text-teal">84 passed</span>, 1 new
<span class="text-fg-3">$</span> gh pr create
<span class="text-blue-2">#412</span> opened</code></pre>
        </div>
      </div>

      <div data-reveal data-delay="2" class={cell}>
        <FilePdf className="h-6 w-6 text-blue-2" weight="regular" />
        <h3 class="mt-4 text-xl font-semibold">Files and canvas</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-fg-2">
          Reads and writes PDFs, spreadsheets, and docs. Drafts long pieces in a Slack canvas your team can edit.
        </p>
      </div>

      <div data-reveal data-delay="3" class={cell}>
        <CalendarCheck className="h-6 w-6 text-blue-2" weight="regular" />
        <h3 class="mt-4 text-xl font-semibold">Scheduled tasks</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-fg-2">Cron in plain English. &ldquo;Every Monday at 8&rdquo; is a complete spec.</p>
        <p class="tnum mt-5 inline-flex items-center gap-2 rounded-chip border border-line bg-ink-2 px-2.5 py-1 font-mono text-[12px] text-fg-2">
          <span class="h-1.5 w-1.5 rounded-full bg-teal" aria-hidden="true"></span>
          next run Mon 08:00
        </p>
      </div>
    </div>
  </div>
</section>

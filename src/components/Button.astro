---
/**
 * Page-wide button. The label is wrapped in <a-scramble> so it scrambles on
 * hover (fine pointers only). Put icons in the `icon` or `after` slots.
 */
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  external?: boolean;
  scramble?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  scramble = true,
  class: className = "",
} = Astro.props;

const sizeClass = size === "lg" ? "h-12 px-6 text-base" : "h-11 px-5 text-[15px]";
---

<a
  href={href}
  class:list={["btn", `btn-${variant}`, sizeClass, className]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <slot name="icon" />
  {scramble ? <a-scramble><slot /></a-scramble> : <span><slot /></span>}
  <slot name="after" />
</a>

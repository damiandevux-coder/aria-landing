---
import Label from "./Label.astro";

const steps = [
  { n: "1", title: "Add Aria to Slack", body: "Install from the Slack app directory. A workspace admin approves once." },
  { n: "2", title: "Invite her to channels", body: "She only sees the channels you add her to. Nothing else, ever." },
  {
    n: "3",
    title: "Give her a job",
    body: "Mention @Aria and describe the task. She asks if something is unclear, then gets to work.",
  },
];
---

<section id="how" class="band scroll-mt-16 overflow-hidden bg-ink-2 py-24 md:py-32" style="--z: 4">
  <div class="mx-auto max-w-[1200px] px-6 md:px-10">
    <header class="max-w-2xl">
      <Label>How it works</Label>
      <a-words class="mt-5">
        <h2 class="text-3xl font-bold sm:text-4xl md:text-5xl">Hiring her takes about two minutes.</h2>
      </a-words>
    </header>

    <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
      {steps.map((s, i) => (
        <li data-reveal data-delay={String(i + 1)} class="relative pt-6">
          <span data-reveal="line" class="absolute inset-x-0 top-0 h-px bg-line-2"></span>
          <span class="tnum font-mono text-[13px] text-blue-2">{s.n}</span>
          <h3 class="mt-3 text-[22px] font-semibold leading-tight">{s.title}</h3>
          <p class="mt-2 max-w-[36ch] text-[16px] leading-relaxed text-fg-2">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>

  <!-- Interactive dot field. Decorative; lights up under the pointer and blinks when idle. -->
  <div class="mt-20 [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]" aria-hidden="true">
    <a-dots class="mx-auto max-w-[1200px] px-6 md:px-10"></a-dots>
  </div>
</section>

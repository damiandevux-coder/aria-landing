---
import { CheckIcon as Check, SlackLogoIcon as SlackLogo } from "@phosphor-icons/react";
import Button from "./Button.astro";
import Label from "./Label.astro";
import { SIGNUP_URL, CTA_LABEL } from "../lib/links";

const included = [
  "3 large agents on your workspace",
  "100M tokens a day",
  "Web, browser, code, files, scheduling",
  "Unlimited channels",
  "Cost posted on every run",
  "Memory you can read and export",
  "Approval flow for sensitive actions",
  "14-day free trial, no card",
];
---

<section id="pricing" class="band scroll-mt-16 bg-ink py-24 md:py-32" style="--z: 7">
  <div class="mx-auto max-w-[1200px] px-6 md:px-10">
    <header class="max-w-2xl">
      <Label>Pricing</Label>
      <a-words class="mt-5">
        <h2 class="text-3xl font-bold sm:text-4xl md:text-5xl">One plan. Everything included.</h2>
      </a-words>
      <p data-reveal data-delay="1" class="mt-4 max-w-[48ch] text-lg text-fg-2">
        Less than a day of a contractor&rsquo;s time, every month. Cancel from Slack.
      </p>
    </header>

    <div
      data-reveal
      data-delay="2"
      class="mt-12 grid overflow-hidden rounded-card border border-line-2 bg-ink-3/60 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]"
    >
      <div class="relative border-b border-line p-8 md:border-b-0 md:border-r md:p-10">
        <div class="pointer-events-none absolute -left-20 -top-20 h-64 w-64 rounded-full bg-blue/20 blur-3xl" aria-hidden="true"></div>
        <div class="relative">
          <p class="text-[15px] font-semibold text-fg-2">Pro</p>
          <p class="mt-4 flex items-baseline gap-1.5">
            <span class="tnum text-6xl font-bold tracking-[-0.04em]">$149</span>
            <span class="text-lg text-fg-2">/ month</span>
          </p>
          <p class="mt-3 text-[15px] text-fg-2">Billed monthly. Usage included, cost still shown per run.</p>
          <Button href={SIGNUP_URL} class="mt-8 w-full sm:w-auto" external>
            <SlackLogo slot="icon" weight="bold" className="h-4 w-4" />
            {CTA_LABEL}
          </Button>
        </div>
      </div>
      <ul class="grid gap-x-8 gap-y-4 p-8 sm:grid-cols-2 md:p-10">
        {included.map((f) => (
          <li class="flex items-start gap-3 text-[15.5px] text-fg">
            <Check className="mt-1 h-4 w-4 shrink-0 text-teal" weight="bold" />
            {f}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
